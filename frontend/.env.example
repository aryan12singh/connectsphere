# Copy to frontend/.env (never commit .env).

# 'live' (default): log in through the real auth-service and Docker stack.
#   Seed accounts/credentials: ../infra/keycloak/connectsphere-realm.json.
# 'mock': explicit isolated test authentication; it does not replace
#   backend persistence or satisfy event-service's live authentication.
NUXT_AUTH_MODE=live

# Where the BFF reaches the backend (Kong). Only used in live mode.
NUXT_API_BASE_URL=http://localhost:8000

# Encrypts the session cookie (must be 32+ characters, or absent).
# Leave this line commented out in development: nuxt-auth-utils then
# generates one and writes it into your .env on first start.
# NEVER set it to an empty value: login then fails with "Empty password".
# Anywhere other than your own laptop, set a real secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUXT_SESSION_PASSWORD=
