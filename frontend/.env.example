# Copy to frontend/.env (never commit .env).

# 'mock' (default): log in with the mock users in server/utils/mockUserDb.ts,
#   e.g. organiser@example.com / Password123!. No backend needed.
# 'live': log in through the real auth-service with the seed users,
#   e.g. sarah.tan@nexuslabs.sg / Password123!. Needs the Docker stack running.
NUXT_AUTH_MODE=mock

# Where the BFF reaches the backend (Kong). Only used in live mode.
NUXT_API_BASE_URL=http://localhost:8000

# Encrypts the session cookie. At least 32 characters. nuxt-auth-utils
# generates one in dev if missing; set a real secret anywhere else.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=
