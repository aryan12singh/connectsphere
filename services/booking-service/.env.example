PORT=3006
DATA_MODE=prisma
DATABASE_URL=postgresql://connectsphere:connectsphere@localhost:5432/booking_db
VENUE_SERVICE_URL=http://localhost:3005
AUTH_SERVICE_URL=http://localhost:3002
INTERNAL_API_KEY=change-me-dev-internal-key

# Current Coordinator assignment proof, using the caller bearer token
EVENT_SERVICE_URL=http://localhost:3003

# Agreed hold/window defaults; Coordinator hold then Staff approval (CS-76).
# Deadlines are inactive at now >= expiresAt, independently of the later worker.
VENUE_HOLD_HOURS=72
VENUE_ALLOW_TOUCHING=true
VENUE_ALLOW_EXPIRY_AT_SETUP=true
