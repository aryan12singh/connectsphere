# Copy to .env for local runs outside Docker (Docker uses infra/docker-compose.yml).
# Local ports: user 3001, auth 3002, event 3003, venue 3004, booking 3005.
PORT=3005
DATA_MODE=prisma
DATABASE_URL=postgresql://connectsphere:connectsphere@localhost:5432/booking_db
VENUE_SERVICE_URL=http://localhost:3004
AUTH_SERVICE_URL=http://localhost:3002
INTERNAL_API_KEY=change-me-dev-internal-key
