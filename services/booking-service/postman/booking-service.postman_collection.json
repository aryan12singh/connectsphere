{
  "info": {
    "name": "ConnectSphere — Auth + Booking Service",
    "description": "Importable Postman collection for the auth-service login and booking-service API through Kong. Set DATA_MODE=prisma and load the booking seed data before running the requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "coordinatorEmail",
      "value": "aisha.rahman@connectsphere.sg"
    },
    {
      "key": "venueStaffEmail",
      "value": "ravi.kumar@marinaconvention.sg"
    },
    {
      "key": "coordinatorToken",
      "value": ""
    },
    {
      "key": "venueStaffToken",
      "value": ""
    },
    {
      "key": "venueId",
      "value": "b3000000-0000-4000-8000-000000000001"
    },
    {
      "key": "eventId",
      "value": "postman-event-001"
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": "postman-booking-001"
    },
    {
      "key": "coordinatorPassword",
      "value": "Aisha@CS05!"
    },
    {
      "key": "venueStaffPassword",
      "value": "Ravi@CS08!"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as event coordinator",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('coordinator login succeeds', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "const body = pm.response.json();",
                  "pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "pm.expect(body.user.role).to.eql('EVENT_COORDINATOR');",
                  "pm.collectionVariables.set('coordinatorToken', body.token);",
                  "pm.collectionVariables.set('actorId', body.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{coordinatorEmail}}\",\n  \"password\": \"{{coordinatorPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/auth/login",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login as venue staff",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('venue staff login succeeds', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "const body = pm.response.json();",
                  "pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "pm.expect(body.user.role).to.eql('VENUE_STAFF');",
                  "pm.collectionVariables.set('venueStaffToken', body.token);",
                  "pm.collectionVariables.set('venueStaffActorId', body.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{venueStaffEmail}}\",\n  \"password\": \"{{venueStaffPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/auth/login",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Booking service",
      "item": [
        {
          "name": "List bookings for a venue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{venueStaffToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/venue-bookings?venueId={{venueId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "venue-bookings"
              ],
              "query": [
                {
                  "key": "venueId",
                  "value": "{{venueId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Coordinator creates a booking (starts TENTATIVELY_HELD)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('booking created or idempotent retry returned', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                  "const body = pm.response.json();",
                  "pm.expect(body.id).to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('bookingId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"venueId\": \"{{venueId}}\",\n  \"title\": \"Postman booking smoke test\",\n  \"reason\": \"Verify booking submission\",\n  \"startAt\": \"2026-12-20T01:00:00.000Z\",\n  \"endAt\": \"2026-12-20T02:00:00.000Z\",\n  \"timeZone\": \"Asia/Singapore\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/venue-bookings",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "venue-bookings"
              ]
            }
          }
        },
        {
          "name": "Retry same booking (idempotency)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"venueId\": \"{{venueId}}\",\n  \"title\": \"Postman booking smoke test\",\n  \"reason\": \"Verify booking submission\",\n  \"startAt\": \"2026-12-20T01:00:00.000Z\",\n  \"endAt\": \"2026-12-20T02:00:00.000Z\",\n  \"timeZone\": \"Asia/Singapore\",\n  \"status\": \"TENTATIVELY_HELD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/venue-bookings",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "venue-bookings"
              ]
            }
          }
        },
        {
          "name": "Get booking",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/venue-bookings/{{bookingId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "venue-bookings",
                "{{bookingId}}"
              ]
            }
          }
        },
        {
          "name": "Venue staff confirms the booking (status change)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{venueStaffToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\",\n  \"reason\": \"Venue staff approved the request\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/venue-bookings/{{bookingId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "venue-bookings",
                "{{bookingId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('venue staff can change status', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "pm.expect(pm.response.json().status).to.eql('CONFIRMED');"
                ]
              }
            }
          ]
        },
        {
          "name": "List booking history for venue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{venueStaffToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/venue-bookings/history?venueId={{venueId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "venue-bookings",
                "history"
              ],
              "query": [
                {
                  "key": "venueId",
                  "value": "{{venueId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Availability intervals",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{venueStaffToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/venue-bookings/availability?venueId={{venueId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "venue-bookings",
                "availability"
              ],
              "query": [
                {
                  "key": "venueId",
                  "value": "{{venueId}}"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
