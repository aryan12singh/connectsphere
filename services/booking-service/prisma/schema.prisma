generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  AVAILABLE
  TENTATIVELY_HELD
  CONFIRMED
  BLOCKED
  UNAVAILABLE
  REJECTED
  CANCELLED
}

model VenueBookingRequest {
  id                String             @id @default(uuid())
  eventId           String?
  venueId           String
  requestedById     String
  title             String
  reason            String
  requestedStart    DateTime
  requestedEnd      DateTime
  timeZone          String             @default("Asia/Singapore")
  status            BookingStatus      @default(TENTATIVELY_HELD)
  idempotencyKey    String
  statusChangedById String?
  statusChangedRole String?
  statusChangedAt   DateTime?
  statusReason      String?
  version           Int                @default(1)
  expiresAt         DateTime?
  expectedAttendance Int?
  layout            String?
  facilities        String[]           @default([])
  accessibilityNeeds String[]          @default([])
  required          Boolean            @default(true)
  setupMinutes      Int                @default(0)
  turnaroundMinutes Int                @default(0)
  occupiedStart     DateTime?
  occupiedEnd       DateTime?
  venueVersion      Int                @default(0)
  requirements      Json?
  requirementsFingerprint String?
  requestFingerprint String?
  flags             String[]           @default([])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  activity          VenueBookingActivity[]
  primarySelections EventPrimaryVenue[]

  @@unique([requestedById, idempotencyKey])
  @@index([venueId, requestedStart, requestedEnd])
  @@index([venueId, status])
  @@map("venue_booking_requests")
}

model BookingOutbox {
  id          String   @id @default(uuid())
  actionKey   String   @unique
  aggregateId String
  kind        String
  payload     Json
  createdAt   DateTime @default(now())
  deliveredAt DateTime?

  @@index([deliveredAt, createdAt])
  @@map("booking_outbox")
}

model VenueBookingActivity {
  id          String               @id @default(uuid())
  bookingId   String
  booking     VenueBookingRequest @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actorId     String
  actorRole   String
  action      String
  fromStatus  BookingStatus?
  toStatus    BookingStatus?
  reason      String
  changes     Json
  occurredAt  DateTime             @default(now())

  @@index([bookingId, occurredAt])
  @@index([actorId, occurredAt])
  @@map("venue_booking_activity")
}

// Cross-service Event identity is retained as an ID; Booking owns this selection.
model EventPrimaryVenue {
  eventId   String   @id
  bookingId String
  booking   VenueBookingRequest @relation(fields: [bookingId], references: [id], onDelete: Restrict, map: "event_primary_venues_booking_fkey")
  version   Int      @default(1)
  actorId   String
  updatedAt DateTime @updatedAt

  @@map("event_primary_venues")
}
