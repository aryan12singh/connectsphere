PORT=3000
DATA_MODE=prisma
DATABASE_URL=postgresql://connectsphere:connectsphere@localhost:5432/attendance_db
AUTH_SERVICE_URL=http://localhost:3002
INTERNAL_API_KEY=change-me-dev-internal-key

# Confirmed Event details and the effective venue list (CS-47/48).
EVENT_SERVICE_URL=http://localhost:3003
BOOKING_SERVICE_URL=http://localhost:3006
VENUE_SERVICE_URL=http://localhost:3005

# RabbitMQ: EventConfirmed / EventCancelled in, registration notices out.
RABBITMQ_URL=amqp://connectsphere:connectsphere-dev-only@localhost:5672
RABBITMQ_EXCHANGE=connectsphere.events
RABBITMQ_QUEUE=attendance-service.domain-events
