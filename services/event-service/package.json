{
  "name": "event-service",
  "version": "0.1.0",
  "private": true,
  "description": "ConnectSphere event-service: OpenAPI event-request lifecycle, assignments, decisions and events.",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "check": "find src -name '*.js' -type f -print0 | xargs -0 -n 1 node --check && DATA_MODE=memory NODE_ENV=test node -e 'require(\"./src/app\")'",
    "build": "npx prisma generate && npm run check",
    "test": "DATA_MODE=memory NODE_ENV=test node --test --test-concurrency=1 tests/unit/*.test.js",
    "test:unit": "DATA_MODE=memory NODE_ENV=test node --test --test-concurrency=1 tests/unit/*.test.js",
    "test:routes": "DATA_MODE=memory NODE_ENV=test node --test --test-concurrency=1 tests/unit/routes.test.js",
    "test:coverage": "DATA_MODE=memory NODE_ENV=test node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-lines=60 --test-coverage-branches=70 --test-coverage-functions=55 --test-coverage-include='src/**/*.js' --test-coverage-include='../utils/**/*.js' tests/unit/*.test.js",
    "test:contract": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "test:integration": "INTERNAL_API_KEY=integration-key node --experimental-test-coverage --test-coverage-lines=60 --test-coverage-branches=70 --test-coverage-functions=50 --test-coverage-include='src/**/*.js' --test-coverage-include='../utils/**/*.js' --test --test-concurrency=1 tests/integration/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "amqplib": "0.10.9",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "prisma": "^6.19.3"
  }
}
