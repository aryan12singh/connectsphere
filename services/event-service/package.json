{
  "name": "event-service",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent event request workflows and authorised activity history",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:coverage": "node --test --test-coverage-include='src/**/*.js' --experimental-test-coverage tests/*.test.js tests/integration/*.test.js",
    "check": "node --check src/app.js && node --check src/workflows.js && node --check src/domain/validation.js",
    "build": "prisma generate && npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "prisma": "^6.19.3"
  }
}
