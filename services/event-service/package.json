{
  "name": "event-service",
  "version": "0.1.0",
  "private": true,
  "description": "ConnectSphere event-service: OpenAPI event-request lifecycle, assignments, decisions and events.",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "DATA_MODE=memory NODE_ENV=test node --test --test-concurrency=1 tests/unit/routes.test.js",
    "test:unit": "DATA_MODE=memory NODE_ENV=test node --test --test-concurrency=1 tests/unit/routes.test.js",
    "test:routes": "DATA_MODE=memory NODE_ENV=test node --test --test-concurrency=1 tests/unit/routes.test.js",
    "test:contract": "python3 -m unittest discover -s tests -p 'test_*.py' -v"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "prisma": "^6.19.3"
  }
}
