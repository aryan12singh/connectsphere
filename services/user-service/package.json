{
  "name": "user-service",
  "version": "0.1.0",
  "private": true,
  "description": "ConnectSphere user-service: owns user profiles and roles (user_db).",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test:unit": "node --test tests/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test --test-coverage-include='src/**/*.js' tests/*.test.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test:integration": "node --experimental-test-coverage --test --test-coverage-include='src/**/*.js' tests/integration/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "prisma": "^6.19.3"
  }
}
