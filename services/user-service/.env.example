# Copy to .env for local runs outside Docker. Never commit the real .env.
PORT=3001
DATABASE_URL=postgresql://connectsphere:connectsphere@localhost:5432/user_db
# Must match INTERNAL_API_KEY in auth-service. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=change-me-dev-internal-key
