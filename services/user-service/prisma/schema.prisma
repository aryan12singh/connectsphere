// ─────────────────────────────────────────────────────────────────────────
// user-service — owns user profiles and roles (user_db).
//
// Matches the columns in the seed file 01_user_db.sql, so the seed loads
// straight into the tables Prisma creates.
//
// Passwords: Keycloak is the source of truth for passwords (hybrid auth).
// `passwordHash` is kept only because the seed contract has it — the login
// flow never reads it. Decided 2026-09-28: keep it, unused. It is optional
// so users created by tech support don't need a fake value.
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider   = "prisma-client-js"
  engineType = "client" // Rust-free client: no engine binary to download, works on Alpine
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // -> user_db
}

// The five roles. Fixed (decided 2026-09-28): tech support can move users
// between roles and change what each role may do, but not add new roles.
enum UserRole {
  EVENT_ORGANISER
  EVENT_COORDINATOR
  VENUE_STAFF
  TECHNICAL_SUPPORT_STAFF
  ATTENDEE
}

// A client organisation (e.g. "Nexus Labs"). Organisers in the same
// organisation can be shown each other's events (Sprint 2 decision; the
// visibility rule itself lives in event-service).
model Organisation {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@map("organisations")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String? // legacy/unused for login — Keycloak checks passwords

  firstName String
  lastName  String

  // Multi-role (Session 2): one account may hold several roles, e.g.
  // EVENT_ORGANISER + ATTENDEE. `roles` is the source of truth.
  //
  // `role` is the DEPRECATED "primary role". It stays only so auth-service
  // and the frontend (which still read `role`) keep working during the
  // migration. A database trigger (see migration 20261002000000) keeps the
  // two in step: role is always one of roles; inserting/updating only
  // `role` rewrites `roles` to [role]. Remove `role` and the trigger once
  // auth-service reads `roles`.
  roles        UserRole[] @default([])
  role         UserRole

  company        String? // free-text label kept for the UI; organisationId is the real link
  organisationId String? // same-service FK. Null for staff and most attendees.
  organisation   Organisation? @relation(fields: [organisationId], references: [id])

  isActive  Boolean  @default(true) // false = disabled by tech support, cannot log in
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@map("users")
}
