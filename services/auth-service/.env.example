# Copy to .env for local runs outside Docker. Never commit the real .env.
PORT=3002
DATABASE_URL=postgresql://connectsphere:connectsphere@localhost:5432/auth_db

KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=connectsphere
KEYCLOAK_CLIENT_ID=auth-service
# Dev-only secret, set in infra/keycloak/connectsphere-realm.json.
# Change both places before anything leaves your laptop.
KEYCLOAK_CLIENT_SECRET=dev-auth-service-secret

USER_SERVICE_URL=http://localhost:3001
# Must match INTERNAL_API_KEY in user-service.
INTERNAL_API_KEY=change-me-dev-internal-key

# Session length, lockout and password rules are set by tech support at
# runtime (PUT /admin/settings), not here.
