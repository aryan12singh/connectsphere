generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VenueType {
  PHYSICAL
  VIRTUAL
  HYBRID
}

enum VenueLayout {
  THEATRE
  CLASSROOM
  CABARET
}

enum VenueWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Venue {
  id                 String              @id @default(uuid())
  name               String
  address            String?
  capacity           Int?
  venueType          VenueType           @default(PHYSICAL)
  supportedLayouts   VenueLayout[]
  facilities         String[]
  accessibilityTags  String[]
  timeZone           String              @default("Asia/Singapore")
  isActive            Boolean             @default(true)
  managedById        String
  setupMinutes      Int                 @default(0)
  turnaroundMinutes Int                 @default(0)
  version           Int                 @default(1)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  operatingHours     VenueOperatingHour[]
  history            VenueHistory[]
  rechecks           VenueRecheckOutbox[]

  @@index([isActive])
  @@map("venues")
}

model VenueRecheckOutbox {
  id          String   @id @default(uuid())
  venueId     String
  venue       Venue    @relation(fields:[venueId],references:[id],onDelete:Cascade)
  version     Int
  payload     Json
  attempts    Int      @default(0)
  lastError   String?
  createdAt   DateTime @default(now())
  deliveredAt DateTime?

  @@unique([venueId,version])
  @@index([deliveredAt,createdAt])
  @@map("venue_recheck_outbox")
}

model VenueOperatingHour {
  id        String        @id @default(uuid())
  venueId  String
  venue    Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  weekday  VenueWeekday
  isClosed Boolean       @default(false)
  opensAt  String?
  closesAt String?

  @@unique([venueId, weekday])
  @@map("venue_operating_hours")
}

model VenueHistory {
  id          String   @id @default(uuid())
  venueId     String
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  actorId     String
  actorRole   String
  action      String
  reason      String
  changes     Json
  occurredAt  DateTime @default(now())

  @@index([venueId, occurredAt])
  @@map("venue_history")
}
