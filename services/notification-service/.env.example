PORT=3000
DATA_MODE=prisma
DATABASE_URL=postgresql://connectsphere:connectsphere@localhost:5432/notification_db
AUTH_SERVICE_URL=http://localhost:3002
# Coordinator names for notices (internal API).
USER_SERVICE_URL=http://localhost:3001
INTERNAL_API_KEY=change-me-dev-internal-key

# RabbitMQ (CS-39 owns the broker). Exchange/queue names are placeholders
# until CS-39 publishes the agreed names.
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=connectsphere.events
RABBITMQ_QUEUE=notification-service.domain-events
