{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "figma-desktop": {
        "type": "remote",
        "url": "http://127.0.0.1:3845/mcp",
        "oauth": false,
        "timeout": 15000
      },
      "figma": {
        "type": "remote",
